{
  "name": "html-static-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:audio": "node ./node_modules/esbuild/bin/esbuild tests/audio-engine.test.mjs --bundle --platform=node --format=esm --outfile=tests/.audio-engine.bundle.mjs && node --test tests/.audio-engine.bundle.mjs"
  },
  "dependencies": {
    "lucide": "^0.469.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
